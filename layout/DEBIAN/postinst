#!/bin/bash

UPDATER="@KAYOKO_INSTALL_PREFIX@/usr/local/libexec/kayoko_updater"

if [ -x "$UPDATER" ]; then
    "$UPDATER" postinst || true
fi

# Quietly restart paste-related daemons when present.
# "No matching processes were found" is not an install failure.
killall -9 druid pasted >/dev/null 2>&1 || true
exit 0
